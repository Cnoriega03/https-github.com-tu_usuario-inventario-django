# Django
SECRET_KEY=change-this-secret-key
DEBUG=False
ALLOWED_HOSTS=your-app.onrender.com,your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com,https://your-domain.com

# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME

# Optional security toggles
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Superusuario automatico para despliegues sin Shell
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-this-admin-password

